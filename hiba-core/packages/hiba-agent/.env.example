# HiBA Agent — 環境變數範本
# 使用方式：cp .env.example .env，填入實際值後執行 npm run start:env

# ── AgentServer ───────────────────────────────────────────
AGENT_PORT=8090

# ── Accounting Server ─────────────────────────────────────
ACCOUNTING_URL=http://localhost:9090

# ── LLM (Ollama) ──────────────────────────────────────────
LLM_URL=http://localhost:11434/v1/chat/completions
# hiba-planner:v1-optimized — lora_target=q/k/v/o_proj, cutoff_len=2048 (faster
# to train than lora_target=all), paired with HttpLLMClient's schema-constrained
# decoding (see buildPlanJsonSchema) which closes most of the accuracy gap that
# reduced LoRA scope alone would leave (eval exact-match 42.2% -> 89.1%, see
# training/quality-history.jsonl and mailbox/2026-08-28_*). Switch to plain
# `hiba-planner:v1` (lora_target=all, exact-match 93.8%) if the last few points
# of accuracy matter more than training time for your use case.
LLM_MODEL=hiba-planner:v1-optimized
LLM_FORMAT=openai
# Lower = more deterministic tool-name selection (default 0.1)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=120000

# ── LLM（執行結果摘要，獨立於上面的 plan() 模型）───────────
SUMMARY_LLM_MODEL=llama3.1:latest
SUMMARY_LLM_TEMPERATURE=0

# ── 遠端 Pi 節點（靜態，優先於 accounting 動態查詢）────────
# 格式：nodeId=http://IP:PORT，多節點逗號分隔
# 範例：NODE_ADDRESSES=m1=http://192.168.50.140:3000,m2=http://192.168.50.141:3000
NODE_ADDRESSES=m1=http://192.168.50.140:3000
DISPATCH_TIMEOUT_MS=30000
RECONNECT_ATTEMPTS=1
RECONNECT_DELAY_MS=1000

# ── 資料庫 ────────────────────────────────────────────────
AUDIT_DB=./hiba-audit.db
TRUST_DB=./hiba-trust.db
WORKFLOW_DB=./hiba-workflows.db
TOPOLOGY_DB=./hiba-topology.db

# ── HiBA Java Core（blockchain protect/verify）───────────
HIBA_BASE_URL=http://localhost:9090
