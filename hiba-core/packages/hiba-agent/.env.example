# HiBA Agent — 環境變數範本
# 使用方式：cp .env.example .env，填入實際值後執行 npm run start:env

# ── AgentServer ───────────────────────────────────────────
AGENT_PORT=8090

# ── Accounting Server ─────────────────────────────────────
ACCOUNTING_URL=http://localhost:9090

# ── LLM (Ollama) ──────────────────────────────────────────
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=hiba-planner
LLM_FORMAT=openai
# Lower = more deterministic tool-name selection (default 0.1)
LLM_TEMPERATURE=0.1

# ── 遠端 Pi 節點（靜態，優先於 accounting 動態查詢）────────
# 格式：nodeId=http://IP:PORT，多節點逗號分隔
# 範例：NODE_ADDRESSES=m1=http://192.168.50.140:3000,m2=http://192.168.50.141:3000
NODE_ADDRESSES=m1=http://192.168.50.140:3000

# ── 資料庫 ────────────────────────────────────────────────
AUDIT_DB=./hiba-audit.db
TRUST_DB=./hiba-trust.db

# ── HiBA Java Core（blockchain protect/verify）───────────
HIBA_BASE_URL=http://localhost:9090
