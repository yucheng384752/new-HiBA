        },
        "orderId": {
          "type": "string",
          "description": "工單 ID，如 WO-2026-001"
        },
        "quantity": {
          "type": "number",
          "description": "執行數量（省略時沿用工單預設）"
        }
      },
      "required": [
        "machineId",
        "orderId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "machineId": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "processed": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "completedAt": {
          "type": "string",
          "description": "完成時間 ISO 8601"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [
        "success",
        "machineId",
        "orderId",
        "product",
        "material",
        "quantity",
        "processed",
        "unit",
        "priority",
        "completedAt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "machine.write"
    ],
    "timeoutMs": 10000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "說明機台與工單 ID",
      "說明加工品、材料、完成數量與單位",
      "明確說明成功或失敗及完成時間"
    ]
  },
  {
