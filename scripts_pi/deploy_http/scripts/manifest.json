[
  {
    "scriptName": "script_1",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "machine.executeOrder",
    "version": "1.0.0",
    "description": "在指定機台執行工單，回傳加工品、材料、數量與完成時間",
    "tags": [
      "machine",
      "write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string",
          "description": "機台 ID，如 CNC-01"
        },
        "orderId": {
          "type": "string",
          "description": "工單 ID，如 WO-2026-001"
        },
        "quantity": {
          "type": "number",
          "description": "執行數量；省略時沿用工單預設"
        }
      },
      "required": [
        "machineId",
        "orderId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "工單是否成功完成"
        },
        "machineId": {
          "type": "string",
          "description": "實際執行工單的機台 ID"
        },
        "orderId": {
          "type": "string",
          "description": "執行的工單 ID"
        },
        "product": {
          "type": "string",
          "description": "加工品名稱"
        },
        "material": {
          "type": "string",
          "description": "加工材料"
        },
        "quantity": {
          "type": "number",
          "description": "要求加工數量"
        },
        "processed": {
          "type": "number",
          "description": "實際完成數量"
        },
        "unit": {
          "type": "string",
          "description": "數量單位"
        },
        "priority": {
          "type": "string",
          "description": "工單優先級"
        },
        "completedAt": {
          "type": "string",
          "description": "完成時間，ISO 8601"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "machine.write"
    ],
    "timeoutMs": 10000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "說明機台與工單 ID",
      "說明加工品、材料、完成數量與單位",
      "明確說明成功或失敗及完成時間"
    ]
  },
  {
    "scriptName": "script_2",
    "renderHint": "status",
    "protocolVersion": "1.0",
    "name": "machine.queryStatus",
    "version": "1.0.0",
    "description": "查詢指定機台的即時狀態、OEE、警報與目前工單",
    "tags": [
      "machine",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string",
          "description": "機台 ID，如 CNC-01 / LATHE-01 / PRESS-01 / WELD-01"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string",
          "description": "機台 ID"
        },
        "name": {
          "type": "string",
          "description": "機台顯示名稱"
        },
        "type": {
          "type": "string",
          "description": "機台類型"
        },
        "line": {
          "type": "string",
          "description": "所屬產線"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "idle",
            "error"
          ],
          "description": "running=運轉中、idle=待機、error=異常"
        },
        "oee": {
          "type": "number",
          "unit": "%",
          "description": "設備綜合效率，範圍 0 到 100"
        },
        "alarms": {
          "type": "array",
          "description": "目前警報；空陣列表示沒有警報"
        },
        "queriedAt": {
          "type": "string",
          "description": "狀態查詢時間，ISO 8601"
        },
        "orderId": {
          "type": [
            "string",
            "null"
          ],
          "description": "running 時正在執行的工單；未派工時為 null"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "machine.read"
    ],
    "timeoutMs": 10000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "必須說明機台狀態與 OEE 百分比",
      "alarms 為空時寫成沒有警報",
      "orderId 有值時說明目前工單"
    ]
  },
  {
    "scriptName": "script_3",
    "renderHint": "chart",
    "protocolVersion": "1.0",
    "name": "env.readSensor",
    "version": "1.0.0",
    "description": "讀取指定或全部環境感測器的溫度、濕度與量測時間",
    "tags": [
      "env",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "sensorId": {
          "type": "string",
          "description": "感測器 ID，如 sensor-01 到 sensor-06；省略時讀取全部"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "unit": "°C",
          "description": "代表性攝氏溫度"
        },
        "humidity": {
          "type": "number",
          "unit": "%RH",
          "description": "代表性相對濕度"
        },
        "sensors": {
          "type": "array",
          "description": "感測器讀值陣列，每筆包含 sensorId、temperature、humidity、timestamp"
        },
        "timestamp": {
          "type": "string",
          "description": "整批量測時間，ISO 8601"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "env.read"
    ],
    "timeoutMs": 5000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "說明感測器 ID、溫度 °C 與濕度 %RH",
      "多筆感測器資料需逐筆整理",
      "保留量測時間"
    ]
  },
  {
    "scriptName": "script_echo",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "orchestrator.echoRtt",
    "version": "1.0.0",
    "description": "驗證 Dashboard 到 Node 的回響通道並量測 RTT 延遲",
    "tags": [
      "orchestrator",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "由 Node 原樣回傳的訊息"
        },
        "sentAt": {
          "type": "string",
          "description": "送出時間，ISO 8601"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "回響測試是否成功"
        },
        "echo": {
          "type": "string",
          "description": "Node 原樣回傳內容"
        },
        "sentAt": {
          "type": "string",
          "description": "送出時間，ISO 8601"
        },
        "receivedAt": {
          "type": "string",
          "description": "Node 接收時間，ISO 8601"
        },
        "rttMs": {
          "type": [
            "number",
            "null"
          ],
          "unit": "ms",
          "description": "來回延遲；無法計算時為 null"
        },
        "nodeId": {
          "type": "string",
          "description": "實際回應的 Node ID"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "orchestrator.read"
    ],
    "timeoutMs": 5000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "說明實際 Node 與連線是否成功",
      "rttMs 有值時以毫秒說明延遲",
      "保留 echo 內容"
    ]
  },
  {
    "scriptName": "script_read_attach",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "material.readAttachment",
    "version": "1.0.0",
    "description": "讀取前端附件並回傳檔案類型、大小、行數與內容預覽",
    "tags": [
      "material",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "maxRows": {
          "type": "number",
          "description": "最多預覽行數或筆數，預設 20"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "附件是否成功讀取"
        },
        "fileName": {
          "type": "string",
          "description": "原始檔名"
        },
        "sizeBytes": {
          "type": "number",
          "unit": "bytes",
          "description": "檔案大小"
        },
        "lineCount": {
          "type": "number",
          "description": "總行數或資料筆數"
        },
        "dataType": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ],
          "description": "辨識出的資料類型"
        },
        "summary": {
          "type": "string",
          "description": "腳本產生的內容摘要"
        },
        "preview": {
          "type": "string",
          "description": "前 N 行或 JSON 預覽內容"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "material.read"
    ],
    "timeoutMs": 5000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "說明檔名、類型、大小與行數",
      "優先使用腳本回傳的 summary",
      "preview 僅在使用者要求內容時整理"
    ]
  },
  {
    "scriptName": "script_fileio",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "env.verifyFileIo",
    "version": "1.0.0",
    "description": "驗證 Node 本地檔案傳輸、寫入及回讀內容是否一致",
    "tags": [
      "env",
      "write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "probe",
            "write",
            "full"
          ],
          "description": "probe=通道測試、write=寫入回讀、full=完整流程"
        },
        "content": {
          "type": "string",
          "description": "write/full 模式寫入內容"
        },
        "filename": {
          "type": "string",
          "description": "測試檔名，預設 test_io.txt"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "整體驗證是否成功"
        },
        "phase": {
          "type": "string",
          "enum": [
            "probe",
            "write",
            "full"
          ],
          "description": "實際執行階段"
        },
        "transferOk": {
          "type": "boolean",
          "description": "傳輸通道是否正常"
        },
        "written": {
          "type": "boolean",
          "description": "內容是否成功寫入"
        },
        "matched": {
          "type": "boolean",
          "description": "回讀內容是否與寫入內容一致"
        },
        "failReason": {
          "type": "string",
          "description": "失敗原因；成功時可能不存在"
        },
        "path": {
          "type": "string",
          "description": "測試檔案絕對路徑"
        },
        "sizeBytes": {
          "type": "number",
          "unit": "bytes",
          "description": "寫入大小"
        },
        "readBack": {
          "type": "string",
          "description": "回讀內容"
        },
        "writtenAt": {
          "type": "string",
          "description": "寫入時間，ISO 8601"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "env.write"
    ],
    "timeoutMs": 5000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "分別說明傳輸、寫入與回讀比對結果",
      "失敗時必須說明 failReason",
      "matched=false 必須標示內容不一致"
    ]
  },
  {
    "scriptName": "system.deployServer",
