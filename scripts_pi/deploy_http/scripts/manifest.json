  {
    "name": "script_fileio",
    "toolName": "env.verifyFileIo",
    "version": "1.0.0",
    "tags": ["env", "write"],
    "permissions": ["env.write"],
    "description": "檔案寫入回讀測試（2-phase）：probe 驗證傳輸通道，write 寫入並回讀驗證",
    "inputSchema": {
      "mode":     { "type": "string", "required": false, "enum": ["probe", "write", "full"], "description": "執行模式：probe=空檔傳輸測試, write=寫入驗證, full=完整流程（預設）" },
      "content":  { "type": "string", "required": false, "description": "要寫入的字串內容（write/full 模式用）" },
      "filename": { "type": "string", "required": false, "description": "檔名（預設 test_io.txt）" }
    },
    "outputSchema": {
      "success":    { "type": "boolean", "description": "整體是否成功" },
      "phase":      { "type": "string",  "enum": ["probe", "write", "full"], "description": "實際執行的階段" },
      "transferOk": { "type": "boolean", "description": "空檔傳輸是否成功（probe/full 模式才有）" },
      "written":    { "type": "boolean", "description": "內容是否寫入（write/full 模式才有）" },
      "matched":    { "type": "boolean", "description": "回讀內容是否與寫入一致" },
      "failReason": { "type": "string",  "description": "失敗原因（失敗時才有）" },
      "path":       { "type": "string" },
      "sizeBytes":  { "type": "number" },
      "readBack":   { "type": "string" },
      "writtenAt":  { "type": "string" },
      "toolName":   { "type": "string", "description": "正式 Tool 名稱，供 AuditTrail 使用" },
      "domain":     { "type": "string", "description": "域分類，供 AuditTrail 使用" }
    },
    "renderHint": "table",
    "timeout": 5000
  },
