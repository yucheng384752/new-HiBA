  {
    "scriptName": "script_fileio",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "env.verifyFileIo",
    "version": "1.0.0",
    "description": "Pi 本地檔案系統讀寫驗證（2-phase：probe 確認通道，write 寫入並回讀）",
    "tags": [
      "env",
      "write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "probe",
            "write",
            "full"
          ],
          "default": "full",
          "description": "執行模式"
        },
        "content": {
          "type": "string",
          "description": "要寫入的字串（write/full 用，省略時使用時間戳）"
        },
        "filename": {
          "type": "string",
          "description": "檔名（省略時使用 test_io.txt）"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "enum": [
            "probe",
            "write",
            "full"
          ]
        },
        "transferOk": {
          "type": "boolean",
          "description": "probe / full 模式：空檔傳輸是否成功"
        },
        "written": {
          "type": "boolean",
          "description": "write / full 模式：是否已寫入"
        },
        "content": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "寫入的絕對路徑"
        },
        "sizeBytes": {
          "type": "number"
        },
        "writtenAt": {
          "type": "string",
          "description": "寫入時間 ISO 8601"
        },
        "readBack": {
          "type": "string",
          "description": "回讀內容"
        },
        "matched": {
          "type": "boolean",
          "description": "寫入內容與回讀是否一致"
        },
        "failReason": {
          "type": "string",
          "description": "probe 失敗原因；成功時不存在"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [
        "success",
        "phase",
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "env.write"
    ],
    "timeoutMs": 15000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "分別說明傳輸、寫入與回讀比對結果",
      "失敗時必須說明 failReason",
      "matched=false 必須標示內容不一致"
    ]
  },
