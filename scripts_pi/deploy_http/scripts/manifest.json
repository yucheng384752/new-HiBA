  {
    "scriptName": "script_3",
    "renderHint": "chart",
    "protocolVersion": "1.0",
    "name": "env.readSensor",
    "version": "1.0.0",
    "description": "讀取 Pi 節點所有環境感測器（溫濕度等），可指定單一感測器 ID",
    "tags": [
      "env",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "sensorId": {
          "type": "string",
          "description": "感測器 ID（省略時讀取全部）"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "代表性溫度（°C）"
        },
        "humidity": {
          "type": "number",
          "description": "代表性相對濕度（%RH）"
        },
        "sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sensorId": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "humidity": {
                "type": "number"
              },
              "timestamp": {
                "type": "string"
              }
            },
            "required": [
              "sensorId",
              "temperature",
              "humidity",
              "timestamp"
            ],
            "additionalProperties": false
          },
          "description": "所有感測器讀值陣列"
        },
        "timestamp": {
          "type": "string",
          "description": "量測時間 ISO 8601"
        },
        "toolName": {
          "type": "string",
          "description": "正式 Tool 名稱，供稽核追蹤"
        },
        "domain": {
          "type": "string",
          "description": "工具所屬領域"
        }
      },
      "required": [
        "sensors",
        "timestamp"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "env.read"
    ],
    "timeoutMs": 5000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    },
    "metadataSchemaVersion": "1.0",
    "summaryHints": [
      "說明感測器 ID、溫度 °C 與濕度 %RH",
      "多筆感測器資料需逐筆整理",
      "保留量測時間"
    ]
  },
  {
    "scriptName": "script_echo",
