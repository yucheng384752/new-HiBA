[
  {
    "scriptName": "script_1",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "machine.executeOrder",
    "version": "1.0.0",
    "description": "在 Pi 節點執行工單（讀取 data_orders.json）",
    "tags": [
      "machine",
      "write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "工單 ID，如 WO-2026-001"
        },
        "quantity": {
          "type": "number",
          "description": "執行數量（省略時沿用工單預設）"
        }
      },
      "required": [
        "orderId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "orderId": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "processed": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "completedAt": {
          "type": "string",
          "description": "完成時間 ISO 8601"
        }
      },
      "required": [
        "success",
        "orderId",
        "product",
        "material",
        "quantity",
        "processed",
        "unit",
        "priority",
        "completedAt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "machine.write"
    ],
    "timeoutMs": 10000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  },
  {
    "scriptName": "script_2",
    "renderHint": "status",
    "protocolVersion": "1.0",
    "name": "machine.queryStatus",
    "version": "1.0.0",
    "description": "查詢機台當前運作狀態",
    "tags": [
      "machine",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string",
          "description": "機台 ID"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "idle",
            "alarm",
            "maintenance"
          ],
          "description": "運作狀態"
        },
        "lastUpdated": {
          "type": "string",
          "description": "最後更新時間 ISO 8601"
        }
      },
      "required": [
        "machineId",
        "status",
        "lastUpdated"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "machine.read"
    ],
    "timeoutMs": 8000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  },
  {
    "scriptName": "script_3",
    "renderHint": "chart",
    "protocolVersion": "1.0",
    "name": "env.readSensor",
    "version": "1.0.0",
    "description": "讀取 Pi 節點所有環境感測器（溫濕度等），可指定單一感測器 ID",
    "tags": [
      "env",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "sensorId": {
          "type": "string",
          "description": "感測器 ID（省略時讀取全部）"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "代表性溫度（°C）"
        },
        "humidity": {
          "type": "number",
          "description": "代表性相對濕度（%RH）"
        },
        "sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sensorId": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "humidity": {
                "type": "number"
              },
              "timestamp": {
                "type": "string"
              }
            },
            "required": [
              "sensorId",
              "temperature",
              "humidity",
              "timestamp"
            ],
            "additionalProperties": false
          },
          "description": "所有感測器讀值陣列"
        },
        "timestamp": {
          "type": "string",
          "description": "量測時間 ISO 8601"
        }
      },
      "required": [
        "sensors",
        "timestamp"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "env.read"
    ],
    "timeoutMs": 5000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  },
  {
    "scriptName": "script_echo",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "orchestrator.echoRtt",
    "version": "1.0.0",
    "description": "Echo 回響 / RTT 測試：驗證 PC→Pi→PC 通道並量測延遲",
    "tags": [
      "orchestrator",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "任意字串，Pi 原樣回傳"
        },
        "sentAt": {
          "type": "string",
          "description": "PC 送出時間戳（ISO 8601），用於計算 RTT"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "echo": {
          "type": "string"
        },
        "sentAt": {
          "type": "string"
        },
        "receivedAt": {
          "type": "string"
        },
        "rttMs": {
          "type": [
            "number",
            "null"
          ],
          "description": "Pi 端量測的來回延遲 ms"
        },
        "nodeId": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "echo",
        "receivedAt",
        "rttMs",
        "nodeId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "orchestrator.read"
    ],
    "timeoutMs": 10000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  },
  {
    "scriptName": "script_read_attach",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "material.readAttachment",
    "version": "1.0.0",
    "description": "讀取前端上傳的附加文件並回傳摘要（_filePath 由後端自動注入）",
    "tags": [
      "material",
      "read"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "_filePath": {
          "type": "string",
          "description": "由後端注入的臨時檔案路徑"
        },
        "_fileName": {
          "type": "string",
          "description": "原始檔名（後端注入）"
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20,
          "description": "最多回傳幾行"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "fileName": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "number"
        },
        "lineCount": {
          "type": "number"
        },
        "preview": {
          "type": "string",
          "description": "前 N 行或 JSON 摘要"
        },
        "dataType": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        }
      },
      "required": [
        "success",
        "fileName",
        "sizeBytes",
        "lineCount",
        "preview",
        "dataType"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "material.read"
    ],
    "timeoutMs": 10000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  },
  {
    "scriptName": "script_fileio",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "env.verifyFileIo",
    "version": "1.0.0",
    "description": "Pi 本地檔案系統讀寫驗證（2-phase：probe 確認通道，write 寫入並回讀）",
    "tags": [
      "env",
      "write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "probe",
            "write",
            "full"
          ],
          "default": "full",
          "description": "執行模式"
        },
        "content": {
          "type": "string",
          "description": "要寫入的字串（write/full 用，省略時使用時間戳）"
        },
        "filename": {
          "type": "string",
          "description": "檔名（省略時使用 test_io.txt）"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "enum": [
            "probe",
            "write",
            "full"
          ]
        },
        "transferOk": {
          "type": "boolean",
          "description": "probe / full 模式：空檔傳輸是否成功"
        },
        "written": {
          "type": "boolean",
          "description": "write / full 模式：是否已寫入"
        },
        "content": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "寫入的絕對路徑"
        },
        "sizeBytes": {
          "type": "number"
        },
        "writtenAt": {
          "type": "string",
          "description": "寫入時間 ISO 8601"
        },
        "readBack": {
          "type": "string",
          "description": "回讀內容"
        },
        "matched": {
          "type": "boolean",
          "description": "寫入內容與回讀是否一致"
        }
      },
      "required": [
        "success",
        "phase",
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "env.write"
    ],
    "timeoutMs": 15000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  },
  {
    "scriptName": "system.deployServer",
    "renderHint": "table",
    "protocolVersion": "1.0",
    "name": "orchestrator.deployServer",
    "version": "1.0.0",
    "description": "在新節點安裝或更新 Pi Sub-Web 伺服器",
    "tags": [
      "orchestrator",
      "write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "hibaRoot": {
          "type": "string",
          "description": "安裝根目錄，預設 /opt/hiba"
        },
        "nodeId": {
          "type": "string",
          "description": "節點 ID，預設 m1"
        },
        "clawUrl": {
          "type": "string",
          "description": "Claw 主控端 URL"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {}
        },
        "warnings": {
          "type": "array",
          "items": {}
        },
        "serverPath": {
          "type": "string"
        },
        "scriptsDir": {
          "type": "string"
        },
        "dataDir": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "steps",
        "warnings",
        "serverPath",
        "scriptsDir",
        "dataDir"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "orchestrator.write"
    ],
    "timeoutMs": 180000,
    "retryPolicy": {
      "maxAttempts": 3,
      "initialDelayMs": 500,
      "backoffMultiplier": 2,
      "retryOn": [
        "TOOL_TIMEOUT"
      ]
    }
  }
]
