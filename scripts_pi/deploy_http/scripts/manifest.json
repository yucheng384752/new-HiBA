        },
        "nodeId": {
          "type": "string",
          "description": "節點 ID，預設 m1"
        },
        "clawUrl": {
          "type": "string",
          "description": "Claw 主控端 URL"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {}
        },
        "warnings": {
          "type": "array",
          "items": {}
        },
        "serverPath": {
          "type": "string"
        },
        "scriptsDir": {
          "type": "string"
        },
        "dataDir": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "steps",
        "warnings",
        "serverPath",
        "scriptsDir",
        "dataDir"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "permissions": [
      "orchestrator.write"
    ],
    "timeoutMs": 180000,
    "retryPolicy": {
